---
interface FaqItem {
  id: string;
  data: {
    question: string;
    answer: string;
  };
}

interface Props {
  faqs: FaqItem[];
}

const { faqs } = Astro.props;
---

<div class="faq-list">
  {faqs.map((faq) => (
    <details class="faq-item">
      <summary>{faq.data.question}</summary>
      <p>{faq.data.answer}</p>
    </details>
  ))}
</div>
