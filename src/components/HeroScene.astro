---
interface Props {
  eyebrow: string;
  title: string;
  subheadline: string;
  copy: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel: string;
  secondaryHref: string;
  heroImage?: string;
  heroImageAlt?: string;
  stats?: Array<{
    label: string;
    value: string;
  }>;
}

const {
  eyebrow,
  title,
  subheadline,
  copy,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  heroImage = '',
  heroImageAlt = 'Cake Marketing Collective founder portrait',
  stats = [],
} = Astro.props;

const hasHeroImage = Boolean(heroImage);
const primaryExternal = primaryHref.startsWith('http');
---

<section class="editorial-hero reveal-on-scroll">
  <div class="editorial-hero__copy">
    <p class="editorial-kicker">{eyebrow}</p>
    <h1 class="editorial-hero__title">{title}</h1>
    <p class="editorial-hero__subheadline">{subheadline}</p>
    <p class="editorial-hero__body">{copy}</p>
    <div class="button-row editorial-hero__actions">
      <a
        class="button"
        href={primaryHref}
        target={primaryExternal ? '_blank' : undefined}
        rel={primaryExternal ? 'noreferrer' : undefined}
      >
        {primaryLabel}
      </a>
      <a class="button button-ghost" href={secondaryHref}>{secondaryLabel}</a>
    </div>
    <div class="editorial-hero__notes">
      <span>Founder-led strategy</span>
      <span>Culture-aware planning</span>
      <span>Performance-first systems</span>
    </div>
  </div>
  <div class="editorial-hero__media">
    {hasHeroImage ? (
      <div class="editorial-hero__image-frame">
        <img class="editorial-hero__image" src={heroImage} alt={heroImageAlt} />
        {stats.length > 0 ? (
          <div class="editorial-stat-grid">
            {stats.slice(0, 4).map((stat) => (
              <div class="editorial-stat-card">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </div>
            ))}
          </div>
        ) : null}
      </div>
    ) : null}
    <div class="editorial-hero__caption">
      <strong>Built for brands that need sharper structure, not more noise.</strong>
      <p>Every section is designed to feel intentional, editorial, and ready to move.</p>
    </div>
  </div>
</section>
