---
interface ServiceItem {
  id: string;
  data: {
    title: string;
    slug: string;
    summary: string;
    detail: string;
    outcome: string;
    deliverables: string[];
  };
}

interface Props {
  services: ServiceItem[];
}

const { services } = Astro.props;
---

<div class="service-grid">
  {services.map((service) => (
    <article class="service-card panel">
      <p class="eyebrow">Service</p>
      <h3>{service.data.title}</h3>
      <p>{service.data.summary}</p>
      <p><strong>Outcome:</strong> {service.data.outcome}</p>
      <ul>
        {service.data.deliverables.slice(0, 2).map((item) => <li>{item}</li>)}
      </ul>
      <div class="button-row">
        <a class="button button-ghost button-small" href={`/services/${service.data.slug}`}>
          View service
        </a>
      </div>
    </article>
  ))}
</div>
