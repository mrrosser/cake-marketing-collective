---
interface NavLink {
  label: string;
  url: string;
}

interface HeaderSettings {
  siteName: string;
  siteTagline: string;
  navigation: NavLink[];
  primaryCtaLabel: string;
  primaryCtaHref: string;
}

interface Props {
  settings: HeaderSettings;
}

const { settings } = Astro.props;
const isPrimaryExternal = settings.primaryCtaHref.startsWith('http');
---

<header class="site-header">
  <a class="brand-lockup" href="/">
    <img
      class="brand-logo"
      src="/images/cake-marketing-logo.png"
      alt="Cake Marketing Collective"
      width="800"
      height="800"
    />
    <span class="brand-stack">
      <span class="brand-name">{settings.siteName}</span>
      <span class="brand-tagline">{settings.siteTagline}</span>
    </span>
  </a>
  <nav class="site-nav" aria-label="Primary">
    {settings.navigation.map((link) => (
      <a href={link.url}>{link.label}</a>
    ))}
    <a href="/insights">Knowledge</a>
  </nav>
  <div class="site-header__actions">
    <div class="utility-nav">
      <a href="/portal">Client Portal</a>
      <a href="/studio">Studio</a>
    </div>
    <a
      class="button button-small"
      href={settings.primaryCtaHref}
      target={isPrimaryExternal ? '_blank' : undefined}
      rel={isPrimaryExternal ? 'noreferrer' : undefined}
    >
      {settings.primaryCtaLabel}
    </a>
  </div>
</header>
