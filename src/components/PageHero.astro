---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-hero reveal-on-scroll">
  <div class="page-hero-copy">
    <p class="editorial-kicker">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="page-hero__description">{description}</p>
  </div>
  <div class="page-hero-aside">
    <slot name="aside" />
  </div>
</section>
