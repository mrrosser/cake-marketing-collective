---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getSingleton, sortByOrder } from '../lib/content';
import {
  buildMarketingAgencySchema,
  buildOrganizationSchema,
} from '../lib/seo';

const settings = (await getSingleton('siteSettings')).data;
const seo = (await getSingleton('seoDefaults')).data;
const city = settings.primaryCity || 'Shreveport';
const caseStudies = sortByOrder(await getCollection('caseStudies'));
const portfolioItems = [
  {
    image: caseStudies[0]?.data.image ?? '/images/founder-cake-editorial.jpeg',
    title: 'Brand Activation',
    caption: 'Experiential plus digital rollout.',
    alt: 'Experiential marketing campaign by Cake Marketing Collective for cultural activation',
  },
  {
    image: '/images/founder-cake-editorial.jpeg',
    title: 'Paid Media Growth',
    caption: 'Performance systems built around cleaner journeys, sharper messaging, and measurable movement.',
    alt: 'Founder of Cake Marketing Collective representing performance marketing strategy',
  },
  {
    image: '/images/founder-cake-editorial.jpeg',
    title: 'Editorial Content',
    caption: 'Storytelling built to carry across launches, campaigns, and long-tail visibility.',
    alt: 'Founder of Cake Marketing Collective representing editorial brand strategy',
  },
];
const title = `Our Work | Performance & Experiential Marketing Case Studies`;
const description =
  'Explore campaigns blending paid media, brand strategy, content production, and experiential marketing with measurable results.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/work"
  ogImage={seo.defaultOgImage}
  keywords={[...seo.caseStudyKeywords, ...seo.serviceKeywords, `creative agency in ${city}`]}
  schemas={[buildOrganizationSchema(settings), buildMarketingAgencySchema(settings)]}
  noIndex={true}
  settings={settings}
>
  <PageHero
    eyebrow="Portfolio"
    title="Proof Over Promises."
    description="Campaigns built to perform."
  >
    <Fragment slot="aside">
      <p class="eyebrow">Visual-first</p>
      <h2>Strategy. Presence. Follow-through.</h2>
      <p>
        This page stays visual on purpose. The goal is to show the tone, polish, and brand
        presence quickly before deeper strategy conversations start.
      </p>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="portfolio-grid">
      {portfolioItems.map((item) => (
        <article class="portfolio-card panel">
          <img src={item.image} alt={item.alt} />
          <div class="portfolio-copy">
            <h3>{item.title}</h3>
            <p>{item.caption}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <article class="section-card panel">
      <p class="eyebrow">Next step</p>
      <h2>Want to see how the work translates into a plan?</h2>
      <p>
        Move from the visual overview into the work archive, then use the intake to map the
        right mix of strategy, campaign support, and execution.
      </p>
      <div class="button-row">
        <a class="button button-ghost" href="/work">View work</a>
        <a class="button" href="/contact">Start a Project</a>
      </div>
    </article>
  </section>
</BaseLayout>
