---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { getSingleton, sortByOrder } from '../lib/content';
import {
  buildMarketingAgencySchema,
  buildOrganizationSchema,
} from '../lib/seo';

const settings = (await getSingleton('siteSettings')).data;
const seo = (await getSingleton('seoDefaults')).data;
const city = settings.primaryCity || 'Shreveport';
const caseStudies = sortByOrder(await getCollection('caseStudies'));
const portfolioItems = [
  {
    image: caseStudies[0]?.data.image ?? '/images/linkfest-placeholder.svg',
    title: 'Brand Activation',
    caption: 'Experiential plus digital rollout.',
    alt: 'Experiential marketing campaign by Cake Marketing Collective for cultural activation',
  },
  {
    image: '/og/default.svg',
    title: 'Paid Media Growth',
    caption: 'Performance systems built around revenue clarity.',
    alt: 'Performance marketing campaign by Cake Marketing Collective for growth brand',
  },
  {
    image: '/images/founder-placeholder.svg',
    title: 'Editorial Content',
    caption: 'Strategic storytelling designed for digital scale.',
    alt: 'Content production campaign by Cake Marketing Collective for editorial brand',
  },
];
const title = `Our Work | Performance & Experiential Marketing Case Studies`;
const description =
  'Explore campaigns blending paid media, brand strategy, content production, and experiential marketing with measurable results.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/work"
  ogImage={seo.defaultOgImage}
  keywords={[...seo.caseStudyKeywords, ...seo.serviceKeywords, `creative agency in ${city}`]}
  schemas={[buildOrganizationSchema(settings), buildMarketingAgencySchema(settings)]}
  noIndex={true}
  settings={settings}
>
  <PageHero
    eyebrow="Portfolio"
    title="Proof Over Promises."
    description="Campaigns built to perform."
  >
    <Fragment slot="aside">
      <p class="eyebrow">Visual-first</p>
      <h2>Strategy. Execution. Scale.</h2>
      <p>
        This page stays light on copy so the work can carry the first impression. Detailed
        breakdowns still live in the case-study archive for deeper ranking and proof.
      </p>
    </Fragment>
  </PageHero>

  <section class="section">
    <div class="portfolio-grid">
      {portfolioItems.map((item) => (
        <article class="portfolio-card panel">
          <img src={item.image} alt={item.alt} />
          <div class="portfolio-copy">
            <h3>{item.title}</h3>
            <p>{item.caption}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <article class="section-card panel">
      <p class="eyebrow">Deeper proof</p>
      <h2>Need the strategy behind the visuals?</h2>
      <p>
        Use the case-studies archive for longer-form breakdowns that connect challenge,
        strategy, execution, and results.
      </p>
      <div class="button-row">
        <a class="button button-ghost" href="/work">View work</a>
        <a class="button" href="/contact">Start a Project</a>
      </div>
    </article>
  </section>
</BaseLayout>
