---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import { getSingleton, sortByOrder } from '../lib/content';
import {
  buildOrganizationSchema,
  buildProfessionalServiceSchema,
  withTitleTemplate,
} from '../lib/seo';

const settings = (await getSingleton('siteSettings')).data;
const seo = (await getSingleton('seoDefaults')).data;
const services = sortByOrder(await getCollection('services'));
const title = withTitleTemplate('Services', seo.titleTemplate);
const description = 'Event branding, experiential design, sponsorship development, digital support, and production strategy for culture-led experiences.';
const schemas = [
  buildOrganizationSchema(settings),
  buildProfessionalServiceSchema(
    settings,
    services.map((service) => service.data),
  ),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/services"
  ogImage={seo.defaultOgImage}
  keywords={seo.serviceKeywords}
  schemas={schemas}
  settings={settings}
>
  <section class="page-hero">
    <div class="page-hero-copy">
      <p class="eyebrow">Services</p>
      <h1>Strategy that feels like culture, not clutter.</h1>
      <p class="hero-body">
        Every offer is built to make the event clearer, stronger, and more memorable for the
        audience, the partners, and the people carrying the vision.
      </p>
    </div>
    <div class="page-hero-visual">
      <div class="status-panel">
        <p class="eyebrow">What stands out</p>
        <h2>Sponsorship is not an afterthought here.</h2>
        <p>
          Cake Marketing Collective treats sponsorship development as part of the event story,
          not just a sales deck. That makes the offer especially strong for community-centered
          events that need aligned support and credible value framing.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <ServiceGrid services={services} />
  </section>
</BaseLayout>
