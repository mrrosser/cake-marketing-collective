---
import { getCollection } from 'astro:content';
import BaseLayout from '../components/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import { getSingleton, sortByOrder } from '../lib/content';
import {
  buildMarketingAgencySchema,
  buildOrganizationSchema,
  buildProfessionalServiceSchema,
} from '../lib/seo';

const settings = (await getSingleton('siteSettings')).data;
const seo = (await getSingleton('seoDefaults')).data;
const home = (await getSingleton('home')).data;
const founder = (await getSingleton('founder')).data;
const caseStudies = sortByOrder(await getCollection('caseStudies'));
const services = sortByOrder(await getCollection('services'));
const featuredCase = caseStudies[0];
const city = settings.primaryCity || 'Shreveport';
const title = `Cake Marketing Collective | Integrated Marketing & Experiential Agency in ${city}`;
const description =
  'A performance-driven marketing agency blending paid media, brand strategy, content production, and experiential campaigns.';
const keywords = [...seo.serviceKeywords, ...seo.geoKeywords, ...seo.caseStudyKeywords];
const serviceHighlights = [
  {
    title: 'Performance Marketing',
    text: 'Paid media systems engineered for measurable revenue growth.',
    href: '/services/performance-marketing',
  },
  {
    title: 'Brand & Web',
    text: 'Positioning, web structure, and messaging built to create clarity and action.',
    href: '/services/branding-web',
  },
  {
    title: 'Experiential Marketing',
    text: 'Moments designed to travel beyond the room and amplify digitally.',
    href: '/services/experiential-marketing',
  },
];
const schemas = [
  buildOrganizationSchema(settings),
  buildMarketingAgencySchema(settings),
  buildProfessionalServiceSchema(settings, services.map((service) => service.data)),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/"
  ogImage={seo.defaultOgImage}
  keywords={keywords}
  schemas={schemas}
  settings={settings}
>
  <HeroScene
    eyebrow={home.heroEyebrow}
    title={home.heroHeadline}
    subheadline={home.heroSubheadline}
    copy={home.heroBody}
    primaryLabel={settings.primaryCtaLabel}
    primaryHref={settings.primaryCtaHref}
    secondaryLabel={settings.secondaryCtaLabel}
    secondaryHref={settings.secondaryCtaHref}
    scenePath={settings.splineScenePath}
    heroImage={founder.image}
    heroImageAlt={`Portrait of ${founder.name}`}
  />

  <section class="section">
    <div class="section-grid">
      <article class="section-card panel">
        <p class="eyebrow">Reality</p>
        <h2>{home.positioningTitle}</h2>
        <p>{home.positioningBody}</p>
        <p class="reality-copy">Marketing infrastructure beats marketing theater.</p>
      </article>
      <article class="section-card panel">
        <p class="eyebrow">Proof</p>
        <h2>Performance-backed, not presentation-backed.</h2>
        <p>Clear outcomes matter more than decorative stat boxes.</p>
        <ul class="proof-list">
          {home.proofPoints.map((point) => (
            <li class="metric-pill">{point}</li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="section-intro">
      <p class="eyebrow">Services</p>
      <h2>{home.servicesTitle}</h2>
      <p class="section-lead">{home.servicesBody}</p>
    </div>
    <div class="grid-3">
      {serviceHighlights.map((item) => (
        <article class="section-card panel">
          <p class="eyebrow">Pillar</p>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <div class="button-row">
            <a class="button button-ghost button-small" href={item.href}>View service</a>
          </div>
        </article>
      ))}
    </div>
    <div class="button-row" style="margin-top: 24px;">
      <a class="button button-ghost" href="/services">Explore all services</a>
    </div>
  </section>

  <section class="section">
    <div class="section-grid">
      <article class="section-card panel">
        <p class="eyebrow">Work</p>
        <h2>{home.caseStudiesTitle}</h2>
        <p>{home.caseStudiesBody}</p>
        {featuredCase ? (
          <>
            <p><strong>{featuredCase.data.title}</strong></p>
            <p>{featuredCase.data.summary}</p>
            <div class="button-row">
              <a class="button button-ghost" href="/work">
                View Work
              </a>
            </div>
          </>
        ) : null}
      </article>
      <article class="section-card panel founder-preview-card">
        <p class="eyebrow">Founder</p>
        <img class="founder-portrait founder-preview-image" src={founder.image} alt="Cake Douglas, founder of Cake Marketing Collective" />
        <h2>Founder-led strategy with operating discipline.</h2>
        <p>{founder.summary}</p>
        <div class="button-row">
          <a class="button button-ghost" href="/about">About Cake</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <article class="section-card panel">
      <p class="eyebrow">GEO Authority</p>
      <h2>{home.collectiveTitle}</h2>
      <p>{home.collectiveBody}</p>
      <p><strong>Primary market:</strong> {city}, {settings.primaryState || 'Louisiana'}.</p>
    </article>
  </section>

  <section class="section">
    <article class="section-card panel">
      <p class="eyebrow">Contact</p>
      <h2>{home.contactTitle}</h2>
      <p>{home.contactBody}</p>
      <div class="button-row">
        <a class="button" href={settings.bookingUrl} target="_blank" rel="noreferrer">
          Book a Strategy Session
        </a>
        <a class="button button-ghost" href="/contact">Start the intake</a>
      </div>
    </article>
  </section>
</BaseLayout>
