---
import BaseLayout from '../components/BaseLayout.astro';
import ContactFlow from '../components/ContactFlow.astro';
import PageHero from '../components/PageHero.astro';
import { getSingleton } from '../lib/content';
import { buildOrganizationSchema, withTitleTemplate } from '../lib/seo';

const settings = (await getSingleton('siteSettings')).data;
const seo = (await getSingleton('seoDefaults')).data;
const title = withTitleTemplate('Work With Us', seo.titleTemplate);
const description = 'Legacy compatibility path for the current CMC contact and booking flow.';
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/contact"
  ogImage={seo.defaultOgImage}
  keywords={seo.fallbackKeywords}
  noIndex={true}
  schemas={[buildOrganizationSchema(settings)]}
  settings={settings}
>
  <PageHero
    eyebrow="Work With Us"
    title="The intake flow now lives under Contact."
    description="This path remains active for compatibility, but the primary navigation and canonical experience now point to the Contact page."
  >
    <Fragment slot="aside">
      <p class="eyebrow">Primary route</p>
      <h2>Use Contact moving forward.</h2>
      <p>Both the intake form and public booking path remain available here.</p>
    </Fragment>
  </PageHero>

  <section class="section">
    <ContactFlow settings={settings} />
  </section>
</BaseLayout>
