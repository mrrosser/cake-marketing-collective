---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceGrid from '../../components/ServiceGrid.astro';
import { getSingleton, sortByOrder } from '../../lib/content';
import {
  buildMarketingAgencySchema,
  buildOrganizationSchema,
  buildProfessionalServiceSchema,
  withTitleTemplate,
} from '../../lib/seo';

const settings = (await getSingleton('siteSettings')).data;
const seo = (await getSingleton('seoDefaults')).data;
const services = sortByOrder(await getCollection('services'));
const city = settings.primaryCity || 'Shreveport';
const title = withTitleTemplate('Integrated Marketing Services', seo.titleTemplate);
const description = `Explore performance marketing, brand strategy, content production, experiential campaigns, and integrated growth services for brands in ${city} and beyond.`;
const schemas = [
  buildOrganizationSchema(settings),
  buildMarketingAgencySchema(settings),
  buildProfessionalServiceSchema(
    settings,
    services.map((service) => service.data),
  ),
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/services"
  ogImage={seo.defaultOgImage}
  keywords={[...seo.serviceKeywords, ...seo.geoKeywords]}
  schemas={schemas}
  settings={settings}
>
  <PageHero
    eyebrow="Services"
    title="Integrated marketing services built to move brands from clarity to action."
    description="From paid media to brand strategy to experiential execution, every offer is designed to support growth with more discipline and less friction."
  >
    <Fragment slot="aside">
      <p class="editorial-kicker">How engagement starts</p>
      <h2>Start with the bottleneck or rebuild the system around revenue.</h2>
      <p>
        Some brands need sharper paid media. Others need cleaner positioning, stronger web
        conversion, or experiential work that can carry digitally after the event ends.
        The service stack is designed to handle both.
      </p>
    </Fragment>
  </PageHero>

  <section class="editorial-band reveal-on-scroll">
    <div class="editorial-band__intro">
      <p class="editorial-kicker">Service hub</p>
      <h2>{`Built for brands in ${city} and beyond that need structure, not noise.`}</h2>
    </div>
    <div class="editorial-band__body">
      <p>
        Cake works across the full system: brand positioning, campaign planning, content,
        digital execution, and high-touch experiences that still need to perform after launch.
      </p>
    </div>
  </section>

  <section class="section">
    <ServiceGrid services={services} />
  </section>

  <section class="editorial-sticky reveal-on-scroll">
    <div class="editorial-sticky__lead">
      <p class="editorial-kicker">How engagements take shape</p>
      <h2>Start where the pressure is showing, then build the system that supports the next phase.</h2>
      <p>
        Some teams need sharper positioning. Others need cleaner conversion, stronger campaign
        planning, or a better bridge between digital and in-person moments. The service mix is
        designed to meet both.
      </p>
    </div>
    <div class="editorial-sticky__stack">
      <article class="editorial-stack-card">
        <p class="editorial-stack-card__count">01</p>
        <h2>Pick the service that matches the current bottleneck.</h2>
        <p>
          Whether the issue is visibility, conversion, messaging, or launch support, each offer
          is scoped to help you see what needs a focused fix and what needs a broader reset.
        </p>
      </article>
      <article class="editorial-stack-card">
        <p class="editorial-stack-card__count">02</p>
        <h2>Use the intake to show where growth is slowing down.</h2>
        <p>
          The intake collects the business context, channel pressure points, and timing. From
          there, Cake can route you into the right next step and recommend the right scope.
        </p>
        <div class="button-row">
          <a class="button" href="/work">View work</a>
          <a class="button button-ghost" href={settings.bookingUrl} target="_blank" rel="noreferrer">
            Book a Strategy Session
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
