---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getSingleton, sortByOrder } from '../../lib/content';
import { buildOrganizationSchema, withTitleTemplate } from '../../lib/seo';

const settings = (await getSingleton('siteSettings')).data;
const seo = (await getSingleton('seoDefaults')).data;
const insights = sortByOrder(await getCollection('insights'));
const title = withTitleTemplate('Insights', seo.titleTemplate);
const description = 'Explore Cake Marketing Collective insights on SEO, brand strategy, experiential work, and integrated marketing systems.';
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const archiveLanes = ['All', 'Knowledge', 'Project Stories'];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/insights"
  ogImage={seo.defaultOgImage}
  keywords={seo.articleKeywords}
  schemas={[buildOrganizationSchema(settings)]}
  settings={settings}
>
  <PageHero
    eyebrow="Knowledge"
    title="A knowledge archive that reads like a point of view, not a content dump."
    description="This page should feel editorial: clear category rhythm, strong titles, and a flow that moves from thought leadership into an actual next step."
  >
    <Fragment slot="aside">
      <p class="editorial-kicker">Archive lanes</p>
      <h2>Knowledge first. Project stories when the work needs to speak.</h2>
      <p>
        The lane styling is adapted from the reference archive: category-first, text-led, and
        paced for scanning before clicking.
      </p>
    </Fragment>
  </PageHero>

  <section class="archive-shell reveal-on-scroll">
    <div class="archive-filters">
      {archiveLanes.map((lane, index) => (
        <span class:list={['archive-filter', index === 1 && 'archive-filter--active']}>{lane}</span>
      ))}
    </div>
    <div class="archive-list">
      {insights.map((insight, index) => (
        <>
          <article class="archive-entry">
            <div class="archive-entry__meta">
              <span>{index === 0 ? 'Knowledge' : 'Project Stories'}</span>
              <span>{dateFormatter.format(new Date(insight.data.publishDate))}</span>
            </div>
            <div class="archive-entry__body">
              <div>
                <p class="archive-entry__category">{insight.data.category}</p>
                <h2>{insight.data.title}</h2>
              </div>
              <div>
                <p>{insight.data.excerpt}</p>
                <a class="button button-ghost button-small" href={`/insights/${insight.data.slug}`}>
                  Read story
                </a>
              </div>
            </div>
          </article>
          {index === 0 ? (
            <article class="archive-cta">
              <div>
                <p class="editorial-kicker">Need the strategy behind the archive?</p>
                <h2>Move from reading to relevance.</h2>
              </div>
              <div>
                <p>
                  The archive should build trust, but the real handoff is still the intake and the
                  strategy session.
                </p>
                <div class="button-row">
                  <a class="button" href="/contact">Start the intake</a>
                  <a class="button button-ghost" href={settings.bookingUrl} target="_blank" rel="noreferrer">
                    Book strategy session
                  </a>
                </div>
              </div>
            </article>
          ) : null}
        </>
      ))}
    </div>
  </section>
</BaseLayout>
